/* Circular world-space "home" button that expands into a pill on hover.

   Rest:  a 100x100 circle — white fill, thick blue ring, blue icon centred.
   Hover: the shape widens into a pill, the blue ring becomes a thin outline and the
          "Torna alla Hall" label fades/slides in next to the icon.
   Un-hover reverses it. Everything is animated via USS transitions; no C# needed.

   NOTE: the icon is a placeholder using 'Spritesheet_Arrow' (pointing left = "back").
   Swap the background-image URL in .home-icon for a dedicated exit/home sprite. */

/* Fills the panel and centres the button on both axes. */
.home-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.home-button {
    width: 100px;
    height: 100px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(58, 127, 255);
    border-right-color: rgb(58, 127, 255);
    border-top-color: rgb(58, 127, 255);
    border-bottom-color: rgb(58, 127, 255);
    border-left-width: 20px;
    border-right-width: 20px;
    border-top-width: 20px;
    border-bottom-width: 20px;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    transition-property: width, border-left-width, border-right-width, border-top-width, border-bottom-width;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* Blue icon (blue-tinted sprite). */
.home-icon {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    background-image: url("project://database/Assets/_Graphics/Environments/Factory/Sprites/Spritesheet.png?fileID=541126889&guid=3a2a53b581da33c45ac2007fbac27667&type=3#Spritesheet_Arrow");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(58, 127, 255);
}

/* Label is collapsed at rest and revealed on hover. */
.home-label {
    flex-shrink: 0;
    width: 0;
    margin-left: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    color: rgb(58, 127, 255);
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: width, margin-left, opacity;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

/* Keep the fill white and the ring blue whatever the runtime theme wants on hover/active/focus. */
.home-button:hover,
.home-button:active,
.home-button:focus {
    background-color: rgb(255, 255, 255);
    border-left-color: rgb(58, 127, 255);
    border-right-color: rgb(58, 127, 255);
    border-top-color: rgb(58, 127, 255);
    border-bottom-color: rgb(58, 127, 255);
}

/* Hover: widen into a pill and thin out the ring. */
.home-button:hover {
    width: 400px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-top-width: 8px;
    border-bottom-width: 8px;
}

/* Hover: reveal the label beside the icon. */
.home-button:hover .home-label {
    width: 250px;
    margin-left: 14px;
    opacity: 1;
}
